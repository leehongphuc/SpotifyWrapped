{
  "expo": {
    "name": "Spotify Wrapped",
    "slug": "spotify-wrapped-teen",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "spotifywrapped",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teen.spotifywrapped"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.teen.spotifywrapped",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "spotifywrapped"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "./plugins/withSpotifyQueries.js"
    ],
    "extra": {
      "spotifyClientId": "d80501e40c4d45adb2b11a05f0f36102",
      "eas": {
        "projectId": "f237e2d2-e19c-4238-93a2-d4c23dc5374f"
      }
    },
    "owner": "leehongphuc"
  }
}